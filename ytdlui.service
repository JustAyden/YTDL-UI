[Unit]
Description=YTDL-UI — yt-dlp web frontend
Documentation=https://github.com/JustAyden/YTDL-UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated unprivileged user — created by install.sh
User=ytdlui
Group=ytdlui
WorkingDirectory=/opt/ytdlui
# Settings live in /opt/ytdlui/config.ini (see config.example.ini).
ExecStart=/opt/ytdlui/.venv/bin/python /opt/ytdlui/server.py
Environment=PYTHONUNBUFFERED=1

# Restart on crashes, and after the app restarts itself for an update.
Restart=always
RestartSec=3

# ── Hardening ────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
# The app folder must stay writable: yt-dlp updates itself in .venv,
# downloads/caches go to data/, and admin web updates replace app files.
ReadWritePaths=/opt/ytdlui
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_UNIX is needed by DNS resolution (nss/systemd-resolved) and the JS runtime.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Note: MemoryDenyWriteExecute is deliberately NOT set — deno/node JIT needs it off.
UMask=0027
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
